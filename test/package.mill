package build.test

import mill.*, scalalib.*

object `package` extends build.ScalaTests, TestModule.ScalaTest {
  def mvnDeps = Seq(mvn"org.scalatest::scalatest:3.2.20")

  private def flagEnabled(propKey: String, envKey: String): Boolean = {
    def truthy(v: String): Boolean =
      v == "1" || v.equalsIgnoreCase("true")
    sys.props.get(propKey).exists(truthy) ||
    sys.env.get(envKey).exists(truthy)
  }

  /** Re-read each Mill invocation so opt-in tags and LUMAFIXV_* env apply. */
  def validationEnabled = Task.Input {
    flagEnabled("luma.validation", "LUMAFIXV_VALIDATION")
  }

  def samplesEnabled = Task.Input {
    flagEnabled("luma.samples", "LUMAFIXV_SAMPLES")
  }

  override def forkEnv = Task.Input {
    sys.env.view.filterKeys(_.startsWith("LUMAFIXV_")).toMap
  }

  override def testArgsDefault = Task {
    val excludes = Seq.newBuilder[String]
    if (!validationEnabled()) {
      excludes += "-l"
      excludes += "Validation"
    }
    if (!samplesEnabled()) {
      excludes += "-l"
      excludes += "Samples"
    }
    excludes.result()
  }

  override def testCachedArgs = testArgsDefault
}
